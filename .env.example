# Sao chép thành .env rồi sửa giá trị. KHÔNG đưa file .env lên Git.

# Cổng của máy chủ API (giao diện dev chạy ở 5173 và chuyển /api về cổng này).
API_PORT=4000

# Đường dẫn file CSDL SQLite (tính từ thư mục gốc dự án).
DB_PATH=server/data/math-buddy.db

# Múi giờ dùng cho thời điểm trong file CSV xuất ra.
REPORT_TIMEZONE=Asia/Ho_Chi_Minh

# Tài khoản tạo sẵn ở LẦN CHẠY ĐẦU (khi CSDL còn trống). Hãy đổi mật khẩu trước khi dùng thật.
SEED_TEACHER_EMAIL=giaovien@mathbuddy.local
SEED_TEACHER_PASSWORD=Buddy@2026
SEED_ADMIN_EMAIL=quantri@mathbuddy.local
SEED_ADMIN_PASSWORD=Admin@2026
# Đặt false để không tạo lớp mẫu DEMO1A.
SEED_DEMO_CLASS=true

# Tùy chọn: bật đoạn tóm tắt bằng mô hình ngôn ngữ trong mục "Phân tích AI" của giáo viên.
# Để trống thì phân tích theo quy tắc vẫn chạy đầy đủ. Khóa chỉ nằm ở máy chủ, không bao giờ gửi xuống trình duyệt.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
