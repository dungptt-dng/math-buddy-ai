# Sao chép file này thành `.env` rồi điền giá trị thật.
# File .env chỉ được đọc ở PHÍA MÁY CHỦ (server/api.mjs), không bao giờ gửi xuống trình duyệt.

# Khóa API Claude (Anthropic). Để trống => ứng dụng dùng NGÂN HÀNG CÓ SẴN, không gọi AI.
ANTHROPIC_API_KEY=

# Mô hình dùng để sinh câu hỏi nháp (mặc định: claude-opus-5-5)
AI_MODEL=claude-opus-5-5

# Mật khẩu Góc giáo viên (kiểm tra ở máy chủ). HÃY ĐỔI giá trị này.
TEACHER_PASSWORD=doi-mat-khau-nay

# Cổng cho máy chủ chạy bản build (npm run start)
PORT=8787
